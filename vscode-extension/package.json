{
  "name": "tangent-local-agent",
  "displayName": "Tangent Local Agent",
  "description": "Browse a Tangle project's runs, resources, and agentic sessions from VS Code, chat with sessions in an editor panel, and host Tangent sub-agents locally with pi.",
  "version": "0.0.27",
  "private": true,
  "publisher": "tangent",
  "license": "Apache-2.0",
  "repository": "github:tangleml/tangle-ui",
  "icon": "resources/icon.png",
  "type": "module",
  "main": "./dist/extension.cjs",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tangle",
          "title": "Tangle",
          "icon": "resources/tangle.svg"
        }
      ]
    },
    "views": {
      "tangle": [
        {
          "id": "tangle.runs",
          "name": "Runs"
        },
        {
          "id": "tangle.resources",
          "name": "Resources"
        },
        {
          "id": "tangle.sessions",
          "name": "Sessions"
        },
        {
          "id": "tangle.savedPipelines",
          "name": "Saved Pipelines"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tangle.savedPipelines",
        "contents": "Install the tangle-deploy CLI to manage saved pipelines, schedules, and subscriptions.\n[Install Help](command:tangle.cli.showInstallHelp)",
        "when": "!tangle.hasCli"
      },
      {
        "view": "tangle.runs",
        "contents": "Select a Tangle project to see its runs.\n[Select Project](command:tangle.selectProject)\n[Set Tangle API URL](command:tangle.setApiUrl)",
        "when": "!tangle.hasProject"
      },
      {
        "view": "tangle.resources",
        "contents": "Select a Tangle project to see its resources.\n[Select Project](command:tangle.selectProject)\n[Set Tangle API URL](command:tangle.setApiUrl)",
        "when": "!tangle.hasProject"
      },
      {
        "view": "tangle.sessions",
        "contents": "Select a Tangle project to see its agentic sessions.\n[Select Project](command:tangle.selectProject)\n[Set Tangle API URL](command:tangle.setApiUrl)",
        "when": "!tangle.hasProject"
      }
    ],
    "submenus": [
      {
        "id": "tangle.fileActions",
        "label": "Tangle Deploy"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tangle.newSession",
          "when": "view == tangle.sessions",
          "group": "navigation@1"
        },
        {
          "command": "tangle.cli.searchRuns",
          "when": "view == tangle.runs && tangle.hasCli",
          "group": "navigation@1"
        },
        {
          "command": "tangle.savedPipelines.refresh",
          "when": "view == tangle.savedPipelines",
          "group": "navigation@1"
        },
        {
          "command": "tangle.selectProject",
          "when": "view =~ /^tangle\\.(runs|resources|sessions)$/",
          "group": "navigation@2"
        },
        {
          "command": "tangle.refresh",
          "when": "view =~ /^tangle\\.(runs|resources|sessions)$/",
          "group": "navigation@3"
        },
        {
          "command": "tangle.openProject",
          "when": "view =~ /^tangle\\.(runs|resources|sessions)$/ && tangle.hasProject",
          "group": "1_project"
        },
        {
          "command": "tangle.setApiUrl",
          "when": "view =~ /^tangle\\.(runs|resources|sessions)$/",
          "group": "2_settings"
        }
      ],
      "view/item/context": [
        {
          "command": "tangle.openRun",
          "when": "view == tangle.runs && viewItem == tangleRun",
          "group": "inline"
        },
        {
          "command": "tangle.cli.runDetails",
          "when": "view == tangle.runs && viewItem == tangleRun && tangle.hasCli",
          "group": "1_run@1"
        },
        {
          "command": "tangle.cli.runLogs",
          "when": "view == tangle.runs && viewItem == tangleRun && tangle.hasCli",
          "group": "1_run@2"
        },
        {
          "command": "tangle.cli.cancelRun",
          "when": "view == tangle.runs && viewItem == tangleRun && tangle.hasCli",
          "group": "1_run@3"
        },
        {
          "command": "tangle.cli.exportRun",
          "when": "view == tangle.runs && viewItem == tangleRun && tangle.hasCli",
          "group": "1_run@4"
        },
        {
          "command": "tangle.cli.getArtifacts",
          "when": "view == tangle.runs && viewItem == tangleRun && tangle.hasCli",
          "group": "2_artifacts@1"
        },
        {
          "command": "tangle.cli.downloadArtifacts",
          "when": "view == tangle.runs && viewItem == tangleRun && tangle.hasCli",
          "group": "2_artifacts@2"
        },
        {
          "command": "tangle.cli.listRunAnnotations",
          "when": "view == tangle.runs && viewItem == tangleRun && tangle.hasCli",
          "group": "3_annotations@1"
        },
        {
          "command": "tangle.cli.setRunAnnotation",
          "when": "view == tangle.runs && viewItem == tangleRun && tangle.hasCli",
          "group": "3_annotations@2"
        },
        {
          "command": "tangle.openResource",
          "when": "view == tangle.resources && viewItem == tangleResource",
          "group": "inline"
        },
        {
          "command": "tangle.openSession",
          "when": "view == tangle.sessions && viewItem == tangleSession",
          "group": "inline"
        },
        {
          "command": "tangle.renameSession",
          "when": "view == tangle.sessions && viewItem == tangleSession",
          "group": "1_edit"
        },
        {
          "command": "tangle.detachSession",
          "when": "view == tangle.sessions && viewItem == tangleSession",
          "group": "2_remove"
        }
      ],
      "editor/context": [
        {
          "submenu": "tangle.fileActions",
          "group": "tangle",
          "when": "tangle.hasCli && resourceExtname =~ /\\.(ya?ml|py)$/ || tangle.hasCli && resourceFilename =~ /[Dd]ockerfile$/"
        }
      ],
      "explorer/context": [
        {
          "submenu": "tangle.fileActions",
          "group": "tangle",
          "when": "tangle.hasCli && resourceExtname =~ /\\.(ya?ml|py)$/ || tangle.hasCli && resourceFilename =~ /[Dd]ockerfile$/"
        }
      ],
      "tangle.fileActions": [
        {
          "command": "tangle.cli.submitPipeline",
          "when": "resourceFilename =~ /\\.pipeline\\.ya?ml$/ || resourceExtname == .py",
          "group": "1_run@1"
        },
        {
          "command": "tangle.cli.validatePipeline",
          "when": "resourceFilename =~ /\\.pipeline\\.ya?ml$/",
          "group": "1_run@2"
        },
        {
          "command": "tangle.cli.viewPipeline",
          "when": "resourceFilename =~ /\\.pipeline\\.ya?ml$/",
          "group": "1_run@3"
        },
        {
          "command": "tangle.cli.diagramPipeline",
          "when": "resourceFilename =~ /\\.pipeline\\.ya?ml$/",
          "group": "1_run@4"
        },
        {
          "command": "tangle.cli.publishComponent",
          "when": "resourceExtname =~ /\\.ya?ml$/ && !(resourceFilename =~ /\\.pipeline\\.ya?ml$/)",
          "group": "2_component@1"
        },
        {
          "command": "tangle.cli.bumpComponentVersion",
          "when": "resourceExtname =~ /\\.ya?ml$/ && !(resourceFilename =~ /\\.pipeline\\.ya?ml$/)",
          "group": "2_component@2"
        },
        {
          "command": "tangle.cli.generateComponentFromPython",
          "when": "resourceExtname == .py",
          "group": "2_component@3"
        },
        {
          "command": "tangle.cli.generateComponentFromDocker",
          "when": "resourceFilename =~ /[Dd]ockerfile$/",
          "group": "2_component@4"
        },
        {
          "command": "tangle.cli.deploySavedPipeline",
          "when": "resourceFilename =~ /\\.pipeline\\.ya?ml$/",
          "group": "3_saved@1"
        },
        {
          "command": "tangle.cli.shipSavedPipeline",
          "when": "resourceExtname == .py",
          "group": "3_saved@2"
        },
        {
          "command": "tangle.cli.hydratePipeline",
          "when": "resourceFilename =~ /\\.pipeline\\.ya?ml$/",
          "group": "4_transform@1"
        },
        {
          "command": "tangle.cli.dehydratePipeline",
          "when": "resourceFilename =~ /\\.pipeline\\.ya?ml$/",
          "group": "4_transform@2"
        },
        {
          "command": "tangle.cli.autoLayoutPipeline",
          "when": "resourceFilename =~ /\\.pipeline\\.ya?ml$/",
          "group": "4_transform@3"
        },
        {
          "command": "tangle.cli.decompilePipeline",
          "when": "resourceFilename =~ /\\.pipeline\\.ya?ml$/",
          "group": "4_transform@4"
        },
        {
          "command": "tangle.cli.compilePipelineFromPython",
          "when": "resourceExtname == .py",
          "group": "4_transform@5"
        },
        {
          "command": "tangle.cli.convertFromAirflow",
          "when": "resourceExtname == .py",
          "group": "4_transform@6"
        }
      ],
      "commandPalette": [
        {
          "command": "tangle.openRun",
          "when": "false"
        },
        {
          "command": "tangle.openResource",
          "when": "false"
        },
        {
          "command": "tangle.openSession",
          "when": "false"
        },
        {
          "command": "tangle.renameSession",
          "when": "false"
        },
        {
          "command": "tangle.detachSession",
          "when": "false"
        },
        {
          "command": "tangle.loadMoreRuns",
          "when": "false"
        },
        {
          "command": "tangle.cli.cancelRun",
          "when": "false"
        },
        {
          "command": "tangle.cli.runLogs",
          "when": "false"
        },
        {
          "command": "tangle.cli.runDetails",
          "when": "false"
        },
        {
          "command": "tangle.cli.exportRun",
          "when": "false"
        },
        {
          "command": "tangle.cli.getArtifacts",
          "when": "false"
        },
        {
          "command": "tangle.cli.downloadArtifacts",
          "when": "false"
        },
        {
          "command": "tangle.cli.listRunAnnotations",
          "when": "false"
        },
        {
          "command": "tangle.cli.setRunAnnotation",
          "when": "false"
        },
        {
          "command": "tangle.savedPipelines.refresh",
          "when": "false"
        }
      ]
    },
