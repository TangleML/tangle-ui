    "configuration": {
      "title": "Tangent Local Agent",
      "properties": {
        "tangent.shellUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Tangent Shell, e.g. http://localhost:5173."
        },
        "tangent.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Reconnect to the saved Shell URL when VS Code starts."
        },
        "tangent.defaultBundleId": {
          "type": "string",
          "default": "",
          "description": "Agent bundle used by \"New Session\". Leave empty to pick from a list."
        },
        "tangent.userEmail": {
          "type": "string",
          "default": "",
          "description": "Email this window mints scoped remote-env tokens as. Must match the identity you chat as, so Tangent routes a session's tools and sub-agents to this window. Leave empty for the local dev identity."
        },
        "tangent.piBin": {
          "type": "string",
          "default": "pi",
          "description": "Path to the pi executable."
        },
        "tangent.piModel": {
          "type": "string",
          "default": "",
          "description": "Model (provider/id) for local sub-agents. Leave empty to use the model Prime asked for."
        },
        "tangent.piProxyUrl": {
          "type": "string",
          "default": "",
          "description": "LLM proxy base URL for local pi. Leave empty to use your own pi configuration."
        },
        "tangent.tangleApiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Base URL of the Tangle backend the Runs, Resources, and Sessions views read from."
        },
        "tangent.tangleUiUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Base URL of the Tangle web app, used to open projects and runs in the browser."
        },
        "tangent.tangleDeployBin": {
          "type": "string",
          "default": "tangle-deploy",
          "description": "Path to the tangle-deploy CLI used to submit, validate, publish, and manage pipelines and components."
        },
        "tangent.updateBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL this extension checks for new .vsix builds (reads <url>/extension/latest.json). Leave empty to use tangent.tangleUiUrl."
        },
        "tangent.autoCheckUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check for a newer extension build on startup and offer to update."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "package": "node esbuild.mjs && vsce package --no-dependencies"
  },
  "dependencies": {
