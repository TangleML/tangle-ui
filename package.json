    "mobx-react-lite": "^4.1.1",
    "nanoid": "^6.0.2",
    "openai": "^7.41.0",
    "papaparse": "^5.7.0",
    "prism-react-renderer": "^2.4.1",
    "pyodide": "^314.0.7",
    "random-words": "^2.0.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-scan": "^0.5.7",
    "react-toastify": "^11.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
