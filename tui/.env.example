# Tangent TUI — Okta SSO config.
#
# Copy to ".env" and fill in your deployment's values. These names are
# UN-prefixed: the web app's VITE_OKTASSO_* / VITE_* variables are NOT read here.
# AUTH_JWT_TOKEN_COOKIE_NAME is the web app's VITE_OKTASSO_TOKEN_COOKIE_NAME.
#
# Leave everything blank/unset for local dev; requests then go out unauthenticated.

OKTASSO_OAUTH_ENDPOINT_BASE=
OKTASSO_TOKEN_EXCHANGE_URL=
OKTASSO_CLIENT_ID=
AUTH_JWT_TOKEN_COOKIE_NAME=

# Optional — defaults shown.
OKTASSO_SCOPES=profile email openid
OKTASSO_REDIRECT_URI=http://localhost:3001/auth
OKTASSO_CALLBACK_PORT=3001
OKTASSO_REFRESH_AFTER_MS=3300000

# JSON array of connect-screen presets. Leave unset to show only "Custom URL".
# Example: [{"label":"my-instance","apiUrl":"https://my-instance.example.com"}]
TANGLE_INSTANCE_PRESETS=
